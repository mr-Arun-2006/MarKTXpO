rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.uid == userId
        && data.role in ['user', 'admin']
        && data.totalXP is number
        && data.totalXP >= 0
        && data.createdAt is string
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('language' in data) || data.language in ['en', 'hi', 'gu', 'ta', 'mr', 'bn'])
        && (!('rankTitle' in data) || (data.rankTitle is string && data.rankTitle.size() <= 100))
        && (!('preferredExchange' in data) || data.preferredExchange in ['NSE', 'BSE', 'BOTH'])
        && (!('experienceLevel' in data) || (data.experienceLevel is string && data.experienceLevel.size() <= 50))
        && (!('virtualCapital' in data) || data.virtualCapital is number);
    }

    // Validation for WatchlistItem
    function isValidWatchlistItem(data, userId) {
      return data.userId == userId
        && data.id is string
        && data.id.size() <= 100
        && data.ticker is string
        && data.ticker.size() <= 20
        && data.stockName is string
        && data.stockName.size() <= 100
        && data.addedAt is string
        && (!('exchange' in data) || data.exchange in ['NSE', 'BSE', 'BOTH'])
        && (!('targetPrice' in data) || data.targetPrice is number)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Validation for PortfolioPosition
    function isValidPortfolioPosition(data, userId) {
      return data.userId == userId
        && data.id is string
        && data.id.size() <= 100
        && data.ticker is string
        && data.ticker.size() <= 20
        && data.type in ['BUY', 'SHORT']
        && data.shares is number
        && data.shares > 0
        && data.entryPrice is number
        && data.entryPrice >= 0
        && data.isPaperTrade is bool
        && data.status in ['OPEN', 'CLOSED']
        && data.createdAt is string
        && (!('stockName' in data) || (data.stockName is string && data.stockName.size() <= 100))
        && (!('stopLoss' in data) || data.stopLoss is number)
        && (!('targetPrice' in data) || data.targetPrice is number)
        && (!('closedAt' in data) || data.closedAt is string);
    }

    // Validation for TradeAlert
    function isValidTradeAlert(data, userId) {
      return data.userId == userId
        && data.id is string
        && data.id.size() <= 100
        && data.ticker is string
        && data.ticker.size() <= 20
        && data.condition in ['ABOVE', 'BELOW', 'ARBITRAGE_SPREAD', 'VOLATILITY_EXPANSION']
        && data.threshold is number
        && data.isActive is bool
        && data.createdAt is string
        && (!('intradayRange' in data) || data.intradayRange is number)
        && (!('average14DayRange' in data) || data.average14DayRange is number)
        && (!('expansionRatio' in data) || data.expansionRatio is number);
    }

    // Validation for GameProgress
    function isValidGameProgress(data, userId) {
      return data.userId == userId
        && data.id is string
        && data.id.size() <= 100
        && data.totalXP is number
        && data.totalXP >= 0
        && data.currentStreak is number
        && data.currentStreak >= 0
        && data.highestStreak is number
        && data.highestStreak >= 0
        && data.updatedAt is string
        && (!('completedLevels' in data) || (data.completedLevels is string && data.completedLevels.size() <= 4000))
        && (!('lastChallengeDate' in data) || (data.lastChallengeDate is string && data.lastChallengeDate.size() <= 20));
    }

    // User Profile rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      // Role assignment is server-controlled; clients may only create regular user profiles.
      allow create: if isOwner(userId)
        && incoming().role == 'user'
        && isValidUserProfile(incoming(), userId);
      // Clients may edit profile preferences, but not privilege/reward/capital fields.
      // Trusted Admin SDK code bypasses these rules for verified administrative operations.
      allow update: if isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().totalXP == existing().totalXP
        && (('virtualCapital' in incoming()) == ('virtualCapital' in existing()))
        && (!('virtualCapital' in existing()) || incoming().virtualCapital == existing().virtualCapital)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      // Watchlist subcollection
      match /watchlist/{watchlistId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWatchlistItem(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidWatchlistItem(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Portfolio subcollection
      match /portfolio/{positionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPortfolioPosition(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidPortfolioPosition(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Alerts subcollection
      match /alerts/{alertId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTradeAlert(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidTradeAlert(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Game Progress subcollection
      match /game_progress/{progressId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGameProgress(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidGameProgress(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
